   "cell_type": "code",
   "execution_count": 1,
   "id": "0a5fa484",
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "\n",
    "auth_data = pd.read_csv('problem1-auth_data-.csv', sep=';')\n",
    "reg_data = pd.read_csv('problem1-reg_data.csv', sep=';')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "0c1b5bb8",
   "metadata": {},
   "outputs": [],
   "source": [
    "data = auth_data.merge(reg_data, on='uid', how='left')\n",
    "\n",
    "data['reg_date'] = pd.to_datetime(data['reg_ts'], unit='s').dt.floor('D')\n",
    "data['auth_date'] = pd.to_datetime(data['auth_ts'], unit='s').dt.floor('D')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "4b79f38c",
   "metadata": {},
   "outputs": [],
   "source": [
    "data['days_since_reg'] = (data['auth_date'] - data['reg_date']).dt.days\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "d82b7ba8",
   "metadata": {},
   "outputs": [],
   "source": [
    "cohorts = data.groupby(['reg_date', 'days_since_reg'])['uid'].nunique().reset_index()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "8c23adb4",
   "metadata": {},
   "outputs": [],
   "source": [
    "retention_matrix = cohorts.pivot_table(\n",
    "    index='reg_date', \n",
    "    columns='days_since_reg', \n",
    "    values='uid', \n",
    "    aggfunc='nunique',\n",
    ").fillna(0)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "45859e9d",
   "metadata": {},
   "outputs": [],
   "source": [
    "retention_pct = retention_matrix.div(retention_matrix[0], axis=0) * 100"
   ]
  },
