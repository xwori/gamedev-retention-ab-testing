    "def calculate_retention(auth_data, reg_data, uid_col='uid', \n",
    "                        auth_ts_col='auth_ts', reg_ts_col='reg_ts',\n",
    "                        max_days=90):\n",
    "    \"\"\"\n",
    "    Рассчитывает retention игроков по дням от даты регистрации.\n",
    "    \n",
    "    Параметры:\n",
    "    -----------\n",
    "    auth_data : DataFrame\n",
    "        Данные с авторизациями (должен содержать uid и auth_ts)\n",
    "    reg_data : DataFrame\n",
    "        Данные с регистрациями (должен содержать uid и reg_ts)\n",
    "    uid_col : str, default='uid'\n",
    "        Название колонки с идентификатором пользователя\n",
    "    auth_ts_col : str, default='auth_ts'\n",
    "        Название колонки с timestamp авторизации\n",
    "    reg_ts_col : str, default='reg_ts'\n",
    "        Название колонки с timestamp регистрации\n",
    "    max_days : int, optional\n",
    "        Максимальное количество дней для расчёта (например, 90)\n",
    "    \n",
    "    Возвращает:\n",
    "    -----------\n",
    "    retention_matrix : DataFrame\n",
    "        Матрица retention в процентах (строки - даты регистрации, столбцы - дни)\n",
    "    \"\"\"\n",
    "    \n",
    "    # Соединям таблицы и переводим вход и регистрацию в date\n",
    "    data = auth_data.merge(reg_data, on='uid', how='left')\n",
    "    data['reg_date'] = pd.to_datetime(data['reg_ts'], unit='s').dt.floor('D')\n",
    "    data['auth_date'] = pd.to_datetime(data['auth_ts'], unit='s').dt.floor('D')\n",
    "    \n",
    "    # Считаем кол-во пройденных дней после регистрации\n",
    "    data['days_since_reg'] = (data['auth_date'] - data['reg_date']).dt.days\n",
    "    \n",
    "    # Фильтруем по max_days если указано\n",
    "    if max_days:\n",
    "        data = data[data['days_since_reg'] <= max_days]\n",
    "        \n",
    "    \n",
    "    # Группируем и считаем кол-во уникальных пользователей\n",
    "    cohorts = data.groupby(['reg_date', 'days_since_reg'])['uid'].nunique().reset_index()\n",
    "    \n",
    "    \n",
    "    # Создаем матрицу\n",
    "    retention_matrix = cohorts.pivot_table(\n",
    "    index='reg_date', \n",
    "    columns='days_since_reg', \n",
    "    values='uid', \n",
    "    aggfunc='nunique'\n",
    "    ).fillna(0)\n",
    "    \n",
    "    \n",
    "    # Преобразуем в проценты (нормализуем по первому дню)\n",
    "    if 0 in retention_matrix.columns:\n",
    "        retention_pct = retention_matrix.div(retention_matrix[0], axis=0) * 100\n",
    "    else:\n",
    "        # Если нет дня 0, используем первый столбец\n",
    "        retention_pct = retention_matrix.div(retention_matrix.iloc[:, 0], axis=0) * 100\n",
    "    \n",
    "    return retention_pct\n",
    "    \n",
    "    \n",
    "\n",
    "retention = calculate_retention(auth_data, reg_data, max_days=90)\n",
    "print(retention)\n",
    "    \n",
    "    \n",
    "    "
